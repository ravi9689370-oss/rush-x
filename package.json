{
  "name": "rush-x",
  "version": "2.0.0",
  "type": "module",
  "description": "RUSH X - 2.5D endless arcade car runner (offline-first PWA + Android)",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-brand.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/sync-brand.mjs && node scripts/gen-icons.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/gen-icons.mjs",
    "brand": "node scripts/sync-brand.mjs",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@resvg/resvg-js": "^2.6.2",
    "vite": "^5.4.21"
  }
}
